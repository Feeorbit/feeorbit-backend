# FeeOrbit Server Environment Configuration

# Server Port
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/feeorbit_db
NODE_ENV=development

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Public Gateway URLs
BACKEND_PUBLIC_URL=http://localhost:5000

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SaaS Membership Defaults
ADVANCE_TRIAL_DAYS=30

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=support@feeorbit.com
BREVO_SENDER_NAME=FeeOrbit

# FeeOrbit Local & Cloud AI Configuration
AI_ENGINE=cloud
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudinary Media Storage (Logo & Member Photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

