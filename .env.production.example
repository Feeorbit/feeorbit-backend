# ==========================================
# FeeOrbit Backend — PRODUCTION ENV TEMPLATE (.env.production.example)
# Copy these key-value pairs into your Render / Railway / Cloud Provider Environment Settings
# ==========================================
PORT=5000
NODE_ENV=production

# MongoDB Atlas Cloud Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@digniflow.bqrqg57.mongodb.net/feeorbit_db?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRE=30d

# Public Gateway URLs
BACKEND_PUBLIC_URL=https://feeorbit-backend-ovhd.onrender.com
FRONTEND_URL=https://feeorbit-frontend.vercel.app

# SaaS Membership Settings
ADVANCE_TRIAL_DAYS=30

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=support@feeorbit.com
BREVO_SENDER_NAME=FeeOrbit

# FeeOrbit Local & Cloud AI Configuration
AI_ENGINE=cloud
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudinary Media Storage (Logo & Member Photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
